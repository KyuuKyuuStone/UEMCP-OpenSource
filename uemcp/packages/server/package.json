{
  "name": "@uemcp/server",
  "version": "0.1.3",
  "description": "UEMCP MCP server (Streamable HTTP / SSE / stdio) for Unreal Engine editor automation (engine version reported by the bridge)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uemcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:sdk": "node scripts/verify-client-validation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@uemcp/shared": "workspace:*",
    "express": "^4.21.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
