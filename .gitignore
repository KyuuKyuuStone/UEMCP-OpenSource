# Node / build artifacts
node_modules/
dist/
*.tsbuildinfo
logs/
pnpm-debug.log*

# Release archives (produced by scripts/pack-bridge.ps1)
dist-release/
# npm pack tarballs (server distribution artefacts; attached to releases, not committed)
*.tgz
*.tar.gz

# Environment / secrets — never commit
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.py[cod]

# Unreal Engine build outputs
Binaries/
Intermediate/
Saved/
DerivedDataCache/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# IDE
.vs/
.idea/
*.sln
*.code-workspace

# Version control internals
.svn/

# Collaboration / session artifacts (internal tooling)
.heihei/

# Local test-run artifacts (assertion runners, audit dirs, pid files)
.test-run/
*.pid

# Test-run logs (baseline evidence lives outside git; see uemcp/tests/baseline-logs/)
*.log
baseline-logs/

# Local verification evidence: contains absolute paths, discovery tokens and
# machine-specific data. Kept on disk, never published.
UEMCPBridge/Tests/smoke-runs/
uemcp/tests/BASELINE-*.md
uemcp/tests/PACKAGE-VERIFY-*.md
uemcp/tests/ZIP-INSTALL-VERIFY-*.md
uemcp/tests/WRITE-OP-VERIFY-*.md

# Unreal projects parked inside the repo directory by the local developer.
# They are NOT part of this project; never commit them.
ue_p_text/UEMCP_TEXT_*/
ue_p_text/*.sln
ue_p_text/*/.vs/

# Never commit credential files (defense in depth)
*credentials*
.git/push-credentials
